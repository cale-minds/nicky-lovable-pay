# =============================================================================
# Nicky Payment Kit — environment variables
# =============================================================================
# These are consumed by the Supabase Edge Functions (server-side). They are set
# as Supabase secrets, NOT bundled into the frontend. Copy what you need; never
# commit real values.
#
#   supabase secrets set NICKY_API_KEY=sk_live_xxx
#
# -----------------------------------------------------------------------------

# REQUIRED — your Nicky public API key. Sent as the `x-api-key` header.
# Generate it yourself in the Nicky dashboard. NEVER expose this to the browser.
NICKY_API_KEY=

# Nicky public API base URL (no trailing slash).
NICKY_API_BASE_URL=https://api-public.pay.nicky.me

# Nicky hosted-checkout base URL, used to build the payer redirect link.
NICKY_PAY_BASE_URL=https://pay.nicky.me

# IP that Nicky webhooks originate from. The webhook receiver validates this.
NICKY_WEBHOOK_ALLOWED_IP=20.76.240.81

# OPTIONAL — override the assets-list endpoint path if your account differs.
# NICKY_ASSETS_ENDPOINT=/api/public/PaymentRequestPublicApi/get-supported-assets

# REQUIRED for nicky-register-webhooks (known only after you deploy functions):
# the public URL of the deployed nicky-webhook function.
# WEBHOOK_CALLBACK_URL=https://<project-ref>.functions.supabase.co/nicky-webhook

# -----------------------------------------------------------------------------
# Supabase runtime variables — injected automatically inside Edge Functions.
# You do NOT normally need to set these by hand; listed here for reference.
# -----------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Frontend (public) values — safe to expose. Used by the React kit to reach the
# Edge Functions. In Lovable/Vite these are typically VITE_-prefixed.
# -----------------------------------------------------------------------------
# VITE_SUPABASE_FUNCTIONS_URL=https://<project-ref>.functions.supabase.co
# VITE_SUPABASE_ANON_KEY=
