# =============================================================================
# Setup-only variables for scripts/register-nicky-webhooks.mjs
# =============================================================================
# These are consumed ONLY by the one-time webhook registration script. They are
# NOT consumed by the Supabase Edge Functions and are NOT runtime plugin config.
#
# Run the script from a trusted local/setup environment only (the API key is
# used to call Nicky directly). Never commit real values.
#
#   NICKY_API_KEY=... NICKY_WEBHOOK_URL=https://<ref>.functions.supabase.co/nicky-webhook \
#     npm run nicky:register-webhooks

# Your Nicky public API key. Used only by this setup script to call Nicky.
# Never exposed to the browser or to the Edge Functions via this file.
NICKY_API_KEY=

# Optional. Nicky public API base URL (no trailing slash).
NICKY_API_BASE_URL=https://api-public.pay.nicky.me

# Required. The FIXED, deployed webhook callback URL. Must be HTTPS and end with
# `/nicky-webhook`. Known only AFTER you deploy the Supabase Edge Functions.
NICKY_WEBHOOK_URL=https://<project-ref>.functions.supabase.co/nicky-webhook
